# Public client configuration. Never place service-role or private provider
# secrets in this file: every EXPO_PUBLIC_* value is bundled into the app.
EXPO_PUBLIC_FSQ_API_KEY=your_foursquare_places_api_key
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Development-only visual layer. Keep false in shared/production environments.
EXPO_PUBLIC_ENABLE_DEMO_HEATMAP=false
