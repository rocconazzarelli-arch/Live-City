{
  "expo": {
    "name": "live-city",
    "slug": "live-city",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/live-city-icon-bw.png",
    "scheme": "livecity",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.rocconazzarelli.livecity",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.rocconazzarelli.livecity",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/live-city-icon-bw.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/live-city-icon-bw.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Se scegli di contribuire, LIVE CITY usa la posizione solo mentre l'app è aperta per inviare una zona approssimata associata a uno pseudonimo giornaliero utile alla heat map. Puoi revocare in qualsiasi momento."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/live-city-splash-bw.png",
          "imageWidth": 132
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
